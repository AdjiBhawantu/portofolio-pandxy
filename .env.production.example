# ==============================================================================
# Portofolio Pandxy - Production Environment Template
# Copy file ini menjadi .env di dalam folder: /home/pang8694/portfolio_backend/.env
# ==============================================================================

NODE_ENV=production
PORT=3000

# 1. Konfigurasi Database MySQL cPanel
DB_HOST=localhost
DB_PORT=3306
DB_USER=pang8694_dbuser
DB_PASSWORD=your_cpanel_db_password
DB_NAME=pang8694_portofolio

# 2. Keamanan Autentikasi Admin (JWT)
JWT_SECRET=super_secret_jwt_key_pandxy_portfolio_2026

# 3. Kredensial Default Admin (digunakan saat migrate jika tabel kosong)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123

# 4. Optional: Supabase & GitHub Integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GITHUB_USERNAME=
NEXT_PUBLIC_GITHUB_TOKEN=
