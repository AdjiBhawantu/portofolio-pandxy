# ==============================================================================
# Portofolio Pandxy - Production .htaccess for public_html
# Connects public_html to /home/pang8694/portfolio_backend
# ==============================================================================

# 1. CloudLinux Phusion Passenger Configuration
# Digunakan oleh cPanel "Setup Node.js App"
<IfModule mod_passenger.c>
    PassengerAppRoot "/home/pang8694/portfolio_backend"
    PassengerBaseURI "/"
    PassengerAppType node
    PassengerStartupFile app.js
</IfModule>

# 2. Apache Rewrite & Static File Serving
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Direct serving: jika file atau folder fisik ada di public_html, layani langsung
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback Reverse Proxy jika Node.js dijalankan mandiri di port 3000
    <IfModule mod_proxy.c>
        RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
    </IfModule>
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Long-term Caching untuk Asset Statis Next.js
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Static build chunks (_next/static)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Media & Fonts
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 5. Gzip & Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
